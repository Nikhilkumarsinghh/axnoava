generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  PROPOSAL
  WON
  LOST
}
enum ProjectStatus {
  INQUIRY
  PROPOSAL
  IN_PROGRESS
  REVIEW
  COMPLETED
  ON_HOLD
  CANCELLED
}
enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}
model Lead {
 id String @id @default(cuid())
 name String
 email String
 company String?
 location String?
 inquiryType String?
 phone String?
 service String?
 budget String?
 message String
 status LeadStatus @default(NEW)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 projects Project[]
 @@index([email])
 @@index([status, createdAt])
}
model User {
 id String @id @default(cuid())
 name String
 email String @unique
 passwordHash String
 role String @default("CLIENT")
 createdAt DateTime @default(now())
 projects Project[]
}
model Project {
 id String @id @default(cuid())
 title String
 description String?
 status ProjectStatus @default(INQUIRY)
 budgetPaise Int?
 dueDate DateTime?
 userId String?
 user User? @relation(fields: [userId], references: [id])
 leadId String?
 lead Lead? @relation(fields: [leadId], references: [id])
 tasks ProjectTask[]
 proposals Proposal[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status, createdAt])
}
model ProjectTask {
 id String @id @default(cuid())
 title String
 description String?
 status String @default("TODO")
 dueDate DateTime?
 projectId String
 project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([projectId, status])
}
model Proposal {
 id String @id @default(cuid())
 title String
 scope String
 amountPaise Int
 currency String @default("INR")
 status String @default("DRAFT")
 validUntil DateTime?
 projectId String
 project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model Payment {
 id String @id @default(cuid())
 providerOrderId String @unique
 providerPaymentId String?
 amount Int
 currency String @default("INR")
 status PaymentStatus @default(CREATED)
 receipt String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model Article {
 id String @id @default(cuid())
 slug String @unique
 title String
 excerpt String
 content String
 published Boolean @default(false)
 publishedAt DateTime?
 createdAt DateTime @default(now())
}

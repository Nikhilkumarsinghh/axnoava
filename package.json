{
  "name": "axnovatech",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n WEB,API \"npm run dev -w @axnovatech/web\" \"npm run dev -w @axnovatech/api\"",
    "dev:web": "npm run dev -w @axnovatech/web",
    "dev:api": "npm run dev -w @axnovatech/api",
    "dev:mobile": "npm run start -w @axnovatech/mobile",
    "db:generate": "npm run db:generate -w @axnovatech/api",
    "db:migrate": "npm run db:migrate -w @axnovatech/api",
    "build": "npm run build -w @axnovatech/web && npm run build -w @axnovatech/api",
    "photos": "npm run photos -w @axnovatech/web",
    "media:setup": "npm run media:setup -w @axnovatech/web",
    "qa:source": "node scripts/qa-source.mjs",
    "media:homepage": "npm run media:setup -w @axnovatech/web -- --only=hero-team,home-film-poster,home-slide-digital,home-slide-ai,home-slide-cloud,home-slide-enterprise,home-slide-products,home-pillar-digital,home-pillar-ai,home-pillar-cloud,home-pillar-enterprise,home-pillar-products,pillar-axnova-digital,pillar-axnova-ai,pillar-axnova-cloud,pillar-axnova-enterprise,pillar-axnova-products,fam-web-development,fam-mobile-app-development,fam-ai-machine-learning,fam-cloud-computing,fam-cybersecurity,fam-ui-ux-design,ind-banking-financial-services,ind-healthcare,ind-retail-e-commerce,ind-education-edtech,ind-manufacturing,ind-logistics-supply-chain,ind-real-estate,ind-government-public-sector,work-uniquetoo-platform,work-axnovatech-platform,home-local-business,home-automation,intro,delivery"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
